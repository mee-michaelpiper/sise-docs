
# Diese Stufe wird verwendet, wenn sie von VS im Schnellmodus ausgeführt wird (Standardeinstellung für Debugkonfiguration).
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
EXPOSE 8081


# Diese Stufe wird zum Erstellen des Dienstprojekts verwendet.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /repo

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV LD_RUN_PATH="/usr/local/lib"

COPY ["src/Meesenburg.ES.API.SAPData/Meesenburg.ES.API.SAPData.csproj", "src/Meesenburg.ES.API.SAPData/"]
#COPY Meesenburg.ES.API.SAPData/Libs/Linux/libsapnwrfc.so /usr/local/lib/libsapnwrfc.so
RUN dotnet restore "src/./Meesenburg.ES.API.SAPData/Meesenburg.ES.API.SAPData.csproj"
COPY . .
WORKDIR "/repo/src/Meesenburg.ES.API.SAPData"
RUN dotnet build "./Meesenburg.ES.API.SAPData.csproj" -c $BUILD_CONFIGURATION -o /app/build

# Diese Stufe wird verwendet, um das Dienstprojekt zu veröffentlichen, das in die letzte Phase kopiert werden soll.
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./Meesenburg.ES.API.SAPData.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# Diese Stufe wird in der Produktion oder bei Ausführung von VS im regulären Modus verwendet (Standard, wenn die Debugkonfiguration nicht verwendet wird).
FROM base AS final
WORKDIR /app
COPY Meesenburg.ES.API.SAPData/Libs/Linux/* /usr/local/lib/
ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV LD_RUN_PATH="/usr/local/lib"
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Meesenburg.ES.API.SAPData.dll"]