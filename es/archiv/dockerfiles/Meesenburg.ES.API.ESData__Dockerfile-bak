FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /repo
COPY ["src/Meesenburg.ES.API.ESData/Meesenburg.de.ES.API.ESData.csproj", "src/Meesenburg.ES.API.ESData/"]
RUN dotnet restore "src/Meesenburg.ES.API.ESData/Meesenburg.de.ES.API.ESData.csproj"
COPY . .
WORKDIR "/repo/src/Meesenburg.ES.API.ESData"
RUN dotnet build "Meesenburg.de.ES.API.ESData.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "Meesenburg.de.ES.API.ESData.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Meesenburg.de.ES.API.ESData.dll"]
